<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NapsterMobileDevelopment.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:NapsterMobileDevelopment"
    xmlns:views="clr-namespace:NapsterMobileDevelopment.Views"
    Title="NapsterMobileDevelopment">
    

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />


    <ShellContent
        Title="Artist"
        ContentTemplate="{DataTemplate views:ArtistPage}"
        Route="ArtistPage"/>


    <ShellContent
        Title="Album"
        ContentTemplate="{DataTemplate views:AlbumPage}"
        Route="AlbumPage"/>

    <ShellContent
        Title="Search"
        ContentTemplate="{DataTemplate views:SearchPage}"
        Route="SearchPage" />


</Shell>
