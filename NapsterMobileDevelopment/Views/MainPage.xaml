<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NapsterMobileDevelopment.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="*,*,*,*">
                
                
            </Grid>

            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="*,*,*,*">

                <CollectionView x:Name="CollectionViewTopArtists" ItemsSource="{Binding TopAlbums}" >
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*" RowDefinitions="3*,*">
                                <Image Source="{Binding CoverArt}" Grid.Row="0"/>
                                <Label Text="{Binding Title}" Grid.Row="1"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>

            <Grid VerticalOptions="End" HorizontalOptions="Fill"  ColumnDefinitions="2*,*,*,*,*,*,2*" BackgroundColor="DarkGray">

                <Grid RowDefinitions="*,*" Grid.Column="1">
                    <ImageButton x:Name="HomePageButton" Source="home.png" BackgroundColor="DarkGray"/>
                    <Label HorizontalOptions="Center" Text="Home" Grid.Column="1" Grid.Row="1"/>
                </Grid>
                <Grid RowDefinitions="*,*" Grid.Column="3">
                    <ImageButton x:Name="SearchPageButton" Source="search.jpg"/>
                    <Label HorizontalOptions="Center" Text="Search" Grid.Column="1" Grid.Row="1"/>
                </Grid>
                <Grid RowDefinitions="*,*" Grid.Column="5">
                    <ImageButton x:Name="PlaylistPageButton" Source="album.png"/>
                    <Label HorizontalOptions="Center" Text="Playlists" Grid.Column="1" Grid.Row="1"/>
                </Grid>

            </Grid>

            <Button
                x:Name="ArtistButton"
                Text="Click me" 
                
                Clicked="OnArtistClicked"
                HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
