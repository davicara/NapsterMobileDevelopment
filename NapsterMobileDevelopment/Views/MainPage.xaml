<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:NapsterMobileDevelopment.Views"
             x:Class="NapsterMobileDevelopment.MainPage">

    <Grid RowDefinitions="8*,auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout
            Padding="5,0"
            Spacing="25">

                <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="*,*,*,*">


                </Grid>

                <Grid ColumnDefinitions="*" RowDefinitions="*,*,*,*">

                    <CollectionView x:Name="CollectionViewTopArtists" ItemsSource="{Binding TopAlbums}" ItemsLayout="VerticalGrid, 2" ItemSizingStrategy="MeasureAllItems">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="3.5*,7*" RowDefinitions="*" HeightRequest="65" Padding="3" >
                                    <Button BackgroundColor="Gray" Grid.ColumnSpan="3" Clicked="AlbumClicked"/>

                                    <Label Text="{Binding Title}" Grid.Column="2" HorizontalOptions="Start" HorizontalTextAlignment="Start" VerticalOptions="Center" Padding="5" FontAttributes="Bold" TextColor="White" />

                                    <Border Padding="0" StrokeThickness="0">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="9"/>
                                        </Border.StrokeShape>

                                        <Image Source="{Binding CoverArt}" Aspect="AspectFill"/>

                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </Grid>

                <Button
                x:Name="ArtistButton"
                Text="Click me" 
                
                Clicked="OnArtistClicked"
                HorizontalOptions="Fill" />
            </VerticalStackLayout>
        </ScrollView>

        <views:Toolbar Grid.Row="1"/>

    </Grid>




</ContentPage>
