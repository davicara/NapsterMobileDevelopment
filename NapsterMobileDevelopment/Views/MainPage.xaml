<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NapsterMobileDevelopment.MainPage">

    <Grid RowDefinitions="8*,*">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout
            Padding="5,0"
            Spacing="25">

                <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="*,*,*,*">


                </Grid>

                <Grid ColumnDefinitions="*" RowDefinitions="*,*,*,*">

                    <CollectionView x:Name="CollectionViewTopArtists" ItemsSource="{Binding TopAlbums}" ItemsLayout="VerticalGrid, 2" ItemSizingStrategy="MeasureAllItems">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="3.5*,7*" RowDefinitions="*" HeightRequest="65" Padding="3" >
                                    <Button BackgroundColor="Gray" Grid.ColumnSpan="3" Clicked="AlbumClicked"/>

                                    <Label Text="{Binding Title}" Grid.Column="2" HorizontalOptions="Start" HorizontalTextAlignment="Start" VerticalOptions="Center" Padding="5" FontAttributes="Bold" TextColor="White" />

                                    <Border Padding="0" StrokeThickness="0">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="9"/>
                                        </Border.StrokeShape>

                                        <Image Source="{Binding CoverArt}" Aspect="AspectFill"/>

                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </Grid>

                <Button
                x:Name="ArtistButton"
                Text="Click me" 
                
                Clicked="OnArtistClicked"
                HorizontalOptions="Fill" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" VerticalOptions="End" HorizontalOptions="Fill"  ColumnDefinitions="2*,*,*,*,*,*,2*" BackgroundColor="DarkGray" HeightRequest="75">

            <Grid RowDefinitions="*,*" Grid.Column="0" VerticalOptions="Center">
                <Button x:Name="HomePageButton" BackgroundColor="DarkGray" Grid.RowSpan="2"/>
                <Image Source="home.png"/>
                <Label HorizontalOptions="Center" Text="Home" Grid.Column="1" Grid.Row="1"/>
            </Grid>
            <Grid RowDefinitions="*,*" Grid.Column="3" VerticalOptions="Center">
                <Button x:Name="SearchPageButton" BackgroundColor="DarkGray" Grid.RowSpan="2"/>
                <Image Source="search.jpg"/>
                <Label HorizontalOptions="Center" Text="Search" Grid.Column="1" Grid.Row="1"/>
            </Grid>
            <Grid RowDefinitions="*,*" Grid.Column="7" VerticalOptions="Center">
                <Button x:Name="PlaylistPageButton" BackgroundColor="DarkGray" Grid.RowSpan="2"/>
                <Image Source="album.png"/>
                <Label HorizontalOptions="Center" Text="Playlists" Grid.Column="1" Grid.Row="1"/>
            </Grid>

        </Grid>
    </Grid>




</ContentPage>
