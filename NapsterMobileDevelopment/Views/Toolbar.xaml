<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NapsterMobileDevelopment.Views.Toolbar">


    <Grid
        VerticalOptions="End"
        ColumnDefinitions="2*,*,*,*,*,*,2*"
        BackgroundColor="Gray"
        HeightRequest="75">

        <Grid RowDefinitions="*,*" Grid.Column="0" VerticalOptions="Center">
            <Button x:Name="HomePageButton"
                    BackgroundColor="Transparent"
                    Grid.RowSpan="2" 
                    Clicked="HomePageClicked"/>
            <Image Source="home.png" />
            <Label Text="Home"
                   HorizontalOptions="Center"
                   Grid.Row="1" />
        </Grid>

        <Grid RowDefinitions="*,*" Grid.Column="3" VerticalOptions="Center">
            <Button x:Name="SearchPageButton"
                    BackgroundColor="Transparent"
                    Grid.RowSpan="2"
                    Clicked="SearchPageClicked"/>
            <Image Source="search.png" />
            <Label Text="Search"
                   HorizontalOptions="Center"
                   Grid.Row="1" />
        </Grid>

        <Grid RowDefinitions="*,*" Grid.Column="6" VerticalOptions="Center">
            <Button x:Name="PlaylistPageButton"
                    BackgroundColor="Transparent"
                    Grid.RowSpan="2" />
            <Image Source="album.png" />
            <Label Text="Playlists"
                   HorizontalOptions="Center"
                   Grid.Row="1" />
        </Grid>

    </Grid>


</ContentView>
